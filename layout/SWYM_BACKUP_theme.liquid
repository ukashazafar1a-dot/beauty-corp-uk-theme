    <!-- utility meta -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_primary }}">
    <meta name="format-detection" content="telephone=no">

    <!-- seo meta -->
    {%- capture seo_title -%}
      {{ page_title }}
      {%- if current_tags -%} {%- assign meta_tags = current_tags | join: ', ' %} &ndash;
        {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {%- endif -%} 
      {%- if current_page != 1 -%} &ndash;
        {{ 'general.meta.page' | t: page:current_page }}
      {%- endif -%} 
      {%- if template == 'password' -%}
        {{ shop.name }}
      {%- else -%} 
        {%- unless page_title contains shop.name -%} &ndash;
          {{ shop.name }}
        {%- endunless -%}
      {%- endif -%}
    {%- endcapture -%}

    <title>{{ seo_title }}</title>

    {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    <!-- icon -->
    {%- if settings.favicon -%}
      <!-- generics -->
      <link rel="icon" sizes="32x32" href="{{ settings.favicon | img_url: '32x32' }}" type="image/png">
      <link rel="icon" sizes="57x57" href="{{ settings.favicon | img_url: '57x57' }}" type="image/png">
      <link rel="icon" sizes="76x76" href="{{ settings.favicon | img_url: '76x76' }}" type="image/png">
      <link rel="icon" sizes="96x96" href="{{ settings.favicon | img_url: '96x96' }}" type="image/png">
      <link rel="icon" sizes="128x128" href="{{ settings.favicon | img_url: '128x128' }}" type="image/png">
      <link rel="icon" sizes="192x192" href="{{ settings.favicon | img_url: '192x192' }}" type="image/png">
      <link rel="icon" sizes="228x228" href="{{ settings.favicon | img_url: '228x228' }}" type="image/png">
      <!-- android -->
      <link rel="shortcut icon" sizes="196x196" href="{{ settings.favicon | img_url: '196x196' }}" type="image/png">
      <!-- ios -->
      <link rel="apple-touch-icon" sizes="120x120" href="{{ settings.favicon | img_url: '120x120' }}" type="image/png">
      <link rel="apple-touch-icon" sizes="152x152" href="{{ settings.favicon | img_url: '152x152' }}" type="image/png">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ settings.favicon | img_url: '180x180' }}" type="image/png">
    {%- endif -%}

    <!-- dns-prefetch -->
    <link rel="dns-prefetch" href="//cdn.shopify.com">
    <link rel="dns-prefetch" href="//monorail-edge.shopifysvc.com">
    <link rel="dns-prefetch" href="//fonts.googleapis.com">
    <link rel="dns-prefetch" href="//fonts.gstatic.com">
    <link rel="dns-prefetch" href="//cdn.judge.me">
    <link rel="dns-prefetch" href="//ajax.cloudflare.com">
    <!-- preconnect -->
    <link rel="preconnect" href="//cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="//monorail-edge.shopifysvc.com" crossorigin>
    <link rel="preconnect" href="//fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="//fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="//cdn.judge.me" crossorigin>
    <link rel="preconnect" href="//ajax.cloudflare.com" crossorigin>

    <!-- styles -->
    <style>
      .nav-mobile,.cart-drawer{visibility:hidden;}
    </style>
    
    <style>
  .product-grid-item__mobile-wish {
    position: absolute;
    width: 24px;
    height: 24px;
    right: 24px;
    top: 24px;
    z-index: 3;
  }
  a.iWishCollAdd {
    text-decoration: none!important;
    cursor: pointer;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
  svg:not(:root) {
    overflow: hidden;
  }
  .after--add{
    display: none;
  }
  .swym-added .after--add{
    display: inline;
  }
  .swym-added .before--add{
    display: none;
  }
  
.footer__bottom {
    padding: 16px 16px !important;
}
      .rf-social .btn--share {
    background-color: white;
    border-radius: 50%;
    border: 1px solid white;
    border-radius: 50%;
   
}
           .rf-social .btn--share svg {
 fill: black;
                 width: 25px;
    height: 25px;
   
}
      .rf-social .btn--share:focus, .rf-social .btn--share:not([disabled]):hover {
    background-color: #ffaa8f;
  
   
}
      
  @media only screen and (min-width: 1024px){
    .product-grid-item__mobile-wish {
      right: 25px;
      top: 25px;
    }
  }
</style>

