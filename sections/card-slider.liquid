<style>
  .rf-fullimg .card-slide__image{
  width:100%;
    height:auto;
  }
</style>

<section class="section {% if section.settings.fullimg %}rf-fullimg{% endif %}">
  {%- if section.settings.subtitle != empty or section.settings.title != empty -%}
    <div class="section__header">
      <span class="section__subtitle">{{ section.settings.subtitle }}</span>
      <h2 class="section__title">{{ section.settings.title }}</h2>
    </div>
  {%- endif -%}

	<div class="card-slider swiper-container">
		<div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- capture supported_sizes -%}{%- render 'image-size', sizes: '200,300,400,600,800,1000,1200,1400,1600', image: block.settings.image -%}{%- endcapture -%}
        {%- assign image_url = block.settings.image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
				<div class="card-slider__slide card-slide{% if section.settings.use_accent_color %} card-slide--accent{% endif %} swiper-slide">
					<div class="card-slide__image">
                     {% if block.settings.link != blank %}
                        <a href="{{block.settings.link}}" style="text-decoration:none;">
                     {% endif %}
                            <img
                              class="lazy fade-in"
                              alt="{{ block.settings.image.alt | escape }}"
                              data-src="{{ image_url }}" 	
                              data-sizes="auto"
                              data-widths="[{{ supported_sizes }}]"
                              >
                      {% if block.settings.link != blank %}
                          </a>
                      {% endif %}
					</div>

					<h3 class="card-slide__title">{{ block.settings.title }}</h3>

					<div class="card-slide__text">
						{{ block.settings.text }}
					</div>
				</div>
            {%- endfor -%}
		</div>

		<div class="swiper-pagination"></div>
	</div>
</section>


{% schema %}
{
	"name": "Card Slider",
	"settings": [
		{
			"type": "checkbox",
			"id": "fullimg",
			"label": "Full Width Images?",
			"default":false
		},
		{
			"type": "text",
			"id": "title",
			"label": "Title"
		},
		{
			"type": "text",
			"id": "subtitle",
			"label": "Sub title"
		},
		{
			"type": "header",
			"content": "Image settings"
		},
		{
			"type": "text",
			"id": "aspect_ratio",
			"label": "Aspect ratio", 
			"default": "1.0"
		},
		{
			"type": "checkbox",
			"id": "use_accent_color",
			"label": "Accent color",
			"default": false
		}
	],
	"blocks": [
		{
			"type": "slide",
			"name": "Slide",
			"settings": [
				{
					"type": "image_picker",
					"id": "image",
					"label": "Image"
				},
				{
					"type": "text",
					"id": "title",
					"label": "Title"
				},
				{
					"type": "richtext",
					"id": "text",
					"label": "Text"
				},
				{
					"type": "url",
					"id": "link",
					"label": "Link"
				}
			]
		}
	], 
    "presets": [
        {
        "category": "Slider",
        "name": "Card Slider"
        }
    ]
}
{% endschema %}