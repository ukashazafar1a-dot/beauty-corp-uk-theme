{% comment %}
{%- if section.settings.page_title_enable or section.settings.page_content_enable -%}
  <div class="page-width page-content{% if section.blocks.size > 0 %} page-content--with-blocks{% endif %}">

    <div class="grid">
      <div class="grid__item medium-up--three-quarters medium-up--push-one-eighth">
        
        {%- if section.settings.page_title_enable -%}
          <header class="section-header">
            <h1 class="section-header__title">{{ page.title }}</h1>
          </header>
        {%- endif -%}

        {%- if section.settings.page_content_enable -%}
          <div class="rte text-spacing">
            {{ page.content }}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
{%- endif -%}
{% endcomment %}
<style>
  .container {
    background-color: #ffffff;
    border-radius: 5px;
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.25), 0 10px 10px rgba(0, 0, 0, 0.22);
    position: relative;
    overflow: hidden;
    width: 768px;
    max-width: 100%;
    min-height: 480px;
    min-width: 370px;
    margin:3% auto;
   
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .form-container {
    display: flex;
  }

  .left-container {
    flex: 1;
    height: 480px;
    background-color: #FDEAE6;
  }

  .right-container {
    display: flex;
    flex: 1;
    height: 460px;
    background-color: #ffffff;
    justify-content: center;
    align-items: center;
  }

  .left-container {
    display: flex;
    flex: 1;
    height: 480px;
    justify-content: center;
    color: gray;
    padding-top:1%;
  }

  .left-container p {
    font-size: 0.9rem;
    margin-top:opx;
  }
  .left-container p strong {
    font-size: medium;
    color:gray;
  }

  .right-inner-container {
    width: 70%;
    height: 80%;
    text-align: center;
  }

  .left-inner-container {
    height: 50%;
    width: 80%;
    text-align: left;
    line-height: 22px;
  }

  input, textarea {
    background-color: #eee;
    border: none;
    padding: 12px 15px;
    margin: 8px 0;
    width: 100%;
    font-size: 0.8rem;
  }

  input:focus, textarea:focus {
    outline: 1px solid #00b4cf;
  }

  button {
    border-radius: 20px;
    border: 1px solid #00b4cf;
    background-color: #00b4cf;
    color: #FFFFFF;
    font-size: 12px;
    font-weight: bold;
    padding: 12px 45px;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: transform 80ms ease-in;
    cursor: pointer;
  }

  button:hover {
    opacity: 0.7;
  }

  @media only screen and (max-width: 600px) {
    .container {
        box-shadow: none;
        width: 98%;
        margin: 3% auto;
      
      	min-width: 300px;
    }
    .form-container{
    	flex-wrap:wrap;
      	flex-direction:column;
      	
    }
    

    .lg-view {
      display: block;
      margin-top: 5% !important;
    }
    .right-container {
		flex:none;
      	width:98%;
      	margin:0 auto;
      	padding:1%;
      	display:block;
    }
    .left-container {
        display: block;
        flex: none;
        padding: 3%;
      	width:100%;
    }
    .left-inner-container {
        height: 50%;
        width: 90%;
        margin: 0 auto;
        text-align: center;
        line-height: 22px;
    }
    .right-inner-container {
      width: 100%;
    }
  }
  @media only screen and (min-width: 600px) {
    .sm-view {
      display: none;
    }
  }
  form p {
    text-align: left;
  }
</style>

<div class="container">
  <div class="form-container">
    <div class="left-container">
      <div class="left-inner-container">
      <h2 style="margin-top:0px;">{{section.settings.content_title}}</h2>
      	{{section.settings.content_body}}
      </div>
      </div>
    <div class="right-container">
      <div class="right-inner-container">
        {%- form 'contact' -%}

            {%- if form.posted_successfully? -%}
              <p class="note note--success">
                {{ 'contact.form.post_success' | t }}
              </p>
            {%- endif -%}

            {{ form.errors | default_errors }}

          	{%- if section.settings.page_title_enable -%}
            	<h2 class="lg-view" style="margin-top:0px;">{{ section.settings.right_title }}</h2>    
            {%- endif -%}
			<p>* {{section.settings.note}}</p>
			<input type="text" placeholder="{{section.settings.name_placeholder}} *" name="contact[name]"  />
      		<input type="email" placeholder="{{section.settings.email_placeholder}} *" name="contact[email]" />
			<input type="phone" placeholder="{{section.settings.phone_placeholder}}" name="contact[phone]" />
          	<textarea rows="4" placeholder="{{section.settings.news_placeholder}}" name="contact[body]"></textarea>
			<button type="submit" class="btn btn-primary">
              {{section.settings.send_button}}
            </button>
		{%- endform -%}
      </div>
    </div>
  </div>
</div>




{% schema %}
  {
    "name": "Page.contact page",
    "settings": [
      {
        "type": "checkbox",
        "id": "page_title_enable",
        "label": "Show page title",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "page_content_enable",
        "label": "Show page content",
        "default": true
      },
      {
        "type": "text",
        "id": "content_title",
        "label": "Left Side Title"
      },
  {
        "type": "text",
        "id": "right_title",
        "label": "Right Side Title",
		"default":"Kontaktiere uns"
      },
      {
        "type": "richtext",
        "id": "content_body",
        "label": "Content Body"
      },
	  {
		"type": "header",
		"content": "Form"
	  },
      {
        "type": "text",
        "id": "note",
        "label": "Note"
      },
      {
        "type": "text",
        "id": "name_placeholder",
        "label": "Name Placeholder"
      },
      {
        "type": "text",
        "id": "email_placeholder",
        "label": "Email Placeholder"
      },
      {
        "type": "text",
        "id": "phone_placeholder",
        "label": "Phone Placeholder"
      },
      {
        "type": "text",
        "id": "news_placeholder",
        "label": "News Placeholder"
      },
      {
        "type": "text",
        "id": "send_button",
        "label": "Send Button"
      }
    ]

  }
{% endschema %}
