<footer class="footer">
	<div class="site-width">
		<div class="footer__top">
			{%- if section.blocks.size > 0 -%}
				{%- for block in section.blocks -%}
					<div class="footer__block footer-{{ block.type }}" {{ block.shopify_attributes }}>
						{%- case block.type -%}
							{%- when 'menu' -%}
								{%- assign linklist = linklists[block.settings.menu] -%}

								{%- if linklist != empty -%}
									<h3 class="footer-menu__title">{{ linklist.title | escape }}</h3>

									<ul class="footer-menu__list">
										{%- for link in linklist.links -%}
											<li class="footer-menu-item">
												<a class="footer-menu-item__link" href="{{ link.url }}">{{ link.title | escape }}</a>
											</li>
										{%- endfor -%}
									</ul>
								{%- endif -%}

							{%- when 'policies' -%}
								{%- if shop.policies != empty -%}
									<h3 class="footer-menu__title">{{ block.settings.title | escape }}</h3>

									<ul class="footer-menu__list">
										{%- for policy in shop.policies -%}
											<li class="footer-menu-item">
												<a class="footer-menu-item__link" href="{{ policy.url }}">{{ policy.title | escape }}</a>
											</li>
										{%- endfor -%}
									</ul>
								{%- endif -%}

							{%- when 'payment' -%}
								{%- capture payment_methods -%}
									{%- for type in shop.enabled_payment_types -%}
									<li class="footer-payment__item">{{ type | payment_type_svg_tag }}</li>
									{%- endfor -%}
								{%- endcapture -%}

								{%- if payment_methods != blank -%}
									<h3 class="footer-menu__title">{{ block.settings.title | escape }}</h3>

									<ul class="footer-payment__list u-nolist">
									{{ payment_methods }}
									</ul>
								{%- endif -%}

							{%- when 'shipping' -%}
								{%- assign carrier = block.settings.carrier | split: ', ' -%}

								{%- if carrier != blank -%}
									<h3 class="footer-menu__title">{{ block.settings.title | escape }}</h3>

									<div class="footer-shipping-list">
										{%- for item in carrier -%}
											{%- assign image_name = item | handle | prepend: 'footer-' | append: '.png' -%}
											{%- assign image_link = images[image_name] | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}

											{%- if image_link != empty and image_link contains 'png' -%}
												<div class="footer-shipping-item">
													<img 	
														class="lazy fade-in" 
														alt="{{ shop.name | escape }}"
														data-src="{{ image_link }}" 	
														data-sizes="auto"
														data-widths="[200,300,400,600]"
														>
												</div>  
											{%- endif -%}
										{%- endfor -%}
									</div>
								{%- endif -%}

						{%- endcase -%}
					</div>
				{%- endfor -%}
			{%- endif -%}
		</div>
<style>
  .rf-social .social-sharing{
      margin-bottom: 8%;
  }
