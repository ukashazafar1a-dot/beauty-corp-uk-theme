<div class="container">

  <h2 style="text-align:center;">{{section.settings.heading}}</h2>

  <div class="accordion">
	{% if section.blocks.size < 0 %}
  			<h3 style="color:red;">No Question Exists!</h3></li>
 			
  		{% else %}
  			<ul id="faq_ul" class="cd-faq__group" style="padding:0px; 10px;">
  				{% for faqs in section.blocks %}
  					<div class="accordion-item">
                        <a>{{faqs.settings.faq_question}}</a>
                        <div class="content">
                          <p>{{faqs.settings.faq_answer}}</p>
                        </div>
                     </div>
  				{% endfor %}
  			</ul>
  		{% endif %}    
  </div>
</div>


{% schema %}
  {
    "name": "FAQ's",
    "settings": [
		{
			"type":"text",
			"id":"heading",
			"label":"Page Heading"
		}
	],
	"blocks":[
		{
			"name":"faq",
			"type":"faq",
			"settings":[
				{
					"type":"text",
					"id":"faq_question",
					"label":"Question"
				},
				{
					"type":"richtext",
					"id":"faq_answer",
					"label":"Answer"
				}
			]
		}
	]
	
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
