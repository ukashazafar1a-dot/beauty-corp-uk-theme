{%- assign items_per_row_mobile  = section.settings.items_per_row_mobile | times: 1 -%}
{%- assign items_per_page  = section.settings.items_per_page | times: 1 -%}

{% assign collection_sort_by = collection.sort_by | default: collection.default_sort_by %}

{% assign prod_count = 0 %}
{% for product in collection.products %}
  {% if product.available %}
	{% assign prod_count = prod_count | plus: 1 %}
  {% endif %}
{% endfor %}

<style>
  {% if items_per_row_mobile == 2 %}
  .product-card{
    width: calc(50% - 4px);
  }
  @media (max-width: 769px){
    .product-discount-tag span{
      min-width: 43px !important;
      font-size: 1rem !important;
      padding: 12px 4px !important;
    }
  }
  {% else %}
  @media screen and (max-width: 1008px){
    .product-card{
      width: calc(100% - 2px);
    }
    .product-card:nth-child(2n) {
      margin: 0 0 12px 0px;
    }
    .product-card:nth-child(odd) {
      margin: 0 0 12px 0px;
    }
  }
  {% endif %}
  
  @media (max-width:769px){
    .collection .site-width{
      padding:0 6px;
    }
  }

</style>

<script>
  window.productsJson = `{{collection.products | json}}`;
</script>

<section class="collection" data-count="{{collection.products_count}}">
	<div class="site-width">
		<div class="collection__actions">
			<div class="collection-filter">
				<button>
					<i></i>
					<span>{{ 'collection.actions.filter' | t }}</span>
				</button>
			</div>
			<div class="collection-sort collection-sort--mobile">
				<label for="sort-by">
					<i></i>
					<span>{{ 'collection.actions.sort_by' | t }}</span>
					<span class="u-visually-hidden">{{ 'collection.actions.sort_by_a11y' | t }}</span>
				</label>
				<select id="sort-by" class="sort-by" name="sort-by">
					{%- for option in collection.sort_options -%}
						{%- capture name_translation_string -%}collection.sort.{{ option.value }}{%- endcapture -%}
						{%- assign name_translation = name_translation_string | t -%}

						{%- unless name_translation contains 'translation missing' or name_translation == empty -%}
							<option value="{{ option.value }}"{% if option.value == collection_sort_by %} selected{% endif %}>
								{{ name_translation }}
							</option>
						{%- endunless -%}
					{%- endfor -%}
				</select>
			</div>
		</div>

		<div class="collection__container">
          <div id="filter" class="collection__start">
        
            <div class="collection-start-container">
              <div class="collection-filter__header">
                <span class="collection-filter__title">{{ 'collection.filter.title' | t }}</span>
              </div>
              
              {%- assign groups = '' -%}
              {%- for tag in collection.all_tags -%}
                {%- assign parts = tag | split: '_' -%}
                {%- if parts.size == 2 -%}
                  {%- assign groups = groups | append: parts.first | append: ',' -%}
                {%- endif -%}
              {%- endfor -%}
              {%- assign groups = groups | split: ',' | compact | uniq -%}
              
              <div class="filter-groups">
                {%- for group in groups -%}
                {%- unless group == 'tag' -%}
                <div class="filter-group">
                  <div class="filter-group__header">
                    <p class="filter-group__title">{{- group | capitalize | escape -}}<span></span></p>
                    <button type="reset">{{section.settings.reset-text}}</button>
                  </div>
                  <ul class="filter-group__list u-nolist">
                    {%- for tag in collection.all_tags -%}
                      {%- assign parts = tag | split: '_' -%}

                      {%- if parts.size != 2 or parts.first != group -%}
                        {%- continue -%}
                      {%- endif -%}
                    
                    <li class="filter-item">
                      <input id="{{ group}}-{{ parts.last }}" class="u-visually-hidden" 
                             type="checkbox"
                             autocomplete='off'
                             name="filter-{{ group }}" 
                             value="{{ tag }}">
                      <label for="{{ group}}-{{ parts.last }}">
                        <div class="filter-item__checkbox swatch-{{ parts.last }}"></div>
                        <span>{{ parts.last | capitalize }}</span>
                      </label>
                    </li>
                    {% endfor %}
                  </ul>
                </div>
                {%- endunless -%}
                {%- endfor %}
              </div>
              <div class="collection-filter__footer">
                <button class="btn btn-primary"><span>{{collection.products_count}}</span> {{section.settings.results}}</button>
              </div>
            </div>
        
        {% comment %}<div class="collection__start">
          <button class="filter-close" aria-label="Filter schließen">
            <span></span>
            <span></span>
          </button>
          <div class="collection-start-container">
            <div class="collection-filter__header">
              <span class="collection-filter__title">{{ 'collection.filter.title' | t }}</span>
            </div>

            {%- assign groups = '' -%}

            {%- for tag in collection.all_tags -%}
              {%- assign parts = tag | split: '_' -%}

              {%- if parts.size == 2 -%}
                {%- assign groups = groups | append: parts.first | append: ',' -%}
              {%- endif -%}
            {%- endfor -%}

            {%- assign groups = groups | split: ',' | compact | uniq -%}

            <div class="filter-groups">
              {%- for group in groups -%}
                <div class="filter-group" data-filter-group="{{ group }}">
                  <div class="filter-group__header">
                    <p class="filter-group__title">
                      {{- group | capitalize | escape -}}
                      <span></span>
                    </p>
                    <button type="reset">{{section.settings.reset-text}}</button>
                  </div>
                  <div class="filter-group__list">
                    {%- for tag in collection.all_tags -%}
                      {%- assign parts = tag | split: '_' -%}

                      {%- if parts.size != 2 or parts.first != group -%}
                        {%- continue -%}
                      {%- endif -%}	

                      <div class="filter-item{% if current_tags contains parts.last %} is-selected{% endif %}">
                        <input
                          id="{{ group}}-{{ parts.last }}"
                          class="u-visually-hidden"
                          type="checkbox"
                          name="filter-{{ group }}"
                          data-filter-group="{{ group }}"
                          data-filter-value="{{ parts.last | replace: 'ü', 'ue' }}"
                          >
                        <label for="{{ group }}-{{ parts.last }}">
                        <div class="filter-item__checkbox swatch-{{ parts.last }}"></div>
                          <span>{{ parts.last | capitalize }}</span>
                        </label>
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>

            <div class="collection-filter__footer">
              <button class="btn btn-primary">{{ 'collection.filter.button' | t }}</button>
            </div>
          </div>
        </div>{% endcomment %}
      </div>
    
			<div class="collection__end">
              {% if collection.metafields.global.top-banner.value != blank and section.settings.show_top_banner %}
              <div class="collection__banner-top">
                <p>{{ collection.metafields.global.top-banner.value }}</p>
              </div>
              {% endif %}
              <div class="collection__main-content">
              {% paginate collection.products by items_per_page %}
				<header class="section__header">
					<h1 class="section__title">
						<span class="u-visually-hidden">{{ 'collection.header.collection_label' | t }}</span>
						{{- collection.title -}}
					</h1>
					<span class="section__subtitle section__subtitle--small" data-collection-count>{{ 'collection.header.products_count' | t: count: collection.products_count }}</span>
                   <div class="collection-sort collection-sort--desktop">
                      <label for="sort-by">
                          <i></i>
                          <span>{{ 'collection.actions.sort_by' | t }}</span>
                          <span class="u-visually-hidden">{{ 'collection.actions.sort_by_a11y' | t }}</span>
                      </label>
                      <select id="sort-by" class="sort-by" name="sort-by">
                          {%- for option in collection.sort_options -%}
                              {%- capture name_translation_string -%}collection.sort.{{ option.value }}{%- endcapture -%}
                              {%- assign name_translation = name_translation_string | t -%}

                              {%- unless name_translation contains 'translation missing' or name_translation == empty -%}
                                  <option value="{{ option.value }}"{% if option.value == collection_sort_by %} selected{% endif %}>
                                      {{ name_translation }}
                                  </option>
                              {%- endunless -%}
                          {%- endfor -%}
                      </select>
                   </div>
                </header>
                <div id="Huratips-Loop" class="collection__products">
          {%- for product in collection.products limit: items_per_page -%}
            {%- if product.available -%}
              {%- render 'product-card', product: product, aspect_ratio: section.settings.aspect_ratio -%}
            {%- endif -%}
          {%- else -%}
            <p>{{ 'collection.products.empty_text' | t }}</p>
          {%- endfor -%}
        </div>
                <div id="Huratips-Pagination">
                  {% if paginate.next %}
                  <center><a class="btn btn-primary" href="{{ paginate.next.url }}">{{ 'collection.pagination.show_more' | t }}</a></center>
                  {% endif %}  
                </div>
              {% endpaginate %}
	        </div>
              {% if collection.metafields.global.bottom-banner.value != blank and section.settings.show_bottom_banner %}
              <div class="collection__banner-bottom">
                <p>{{ collection.metafields.global.bottom-banner.value }}</p>
              </div>
              {% endif %}
          </div>
	</div>
  </div>
</section>

<script>
  window.theme.products = {{ collection.products | json }};
</script>

<script>
  window.collection_translations = {
    is_loading: '{{ 'collection.pagination.is_loading' | t }}',
  };
</script>


{% schema %}
{
	"name": "Collection",
	"settings": [
		{
			"type": "header",
			"content": "Collection header"
		},
		{
			"type": "header",
			"content": "Product grid"
		},
		{
			"type": "range",
			"id": "items_per_page",
			"label": "Products per page",
			"min": 5,
			"max": 50,
			"step": 5,
			"default": 40
		},
		{
			"type": "select",
			"id": "items_per_row_mobile",
			"label": "Products per row (mobile)",
			"options": [
			  {
				"value": "1",
				"label": "1"
			  },
			  {
				"value": "2",
				"label": "2"
			  }
			],
			"default": "2"
		},
		{
			"type": "text",
			"id": "aspect_ratio",
			"label": "Aspect ratio",
			"default": "1.0"
		},
		{
			"type": "text",
			"id": "reset-text",
			"label": "Clear Text",
			"default": "Zurücksetzen"
		},
		{
		    "type": "text",
			"id": "results",
			"label": "Resutls Text",
			"default": "Ergebnisse anzeigen"
		},
		{
			"type": "header",
			"content": "Banners"
		},
		{
		    "type": "checkbox",
			"id": "show_top_banner",
			"label": "Show Top Banner",
			"default": false
		},
		{
		    "type": "checkbox",
			"id": "show_bottom_banner",
			"label": "Show Bottom Banner",
			"default": false
		}
	]
}
{% endschema %}