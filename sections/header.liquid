{%- assign main_menu_handle = section.settings.navigation_menu | default: 'main-menu' -%}
{%- assign main_menu = linklists[main_menu_handle] -%}

<header class="header">
    <div class="site-width" style="position:unset;">

        <div class="header-top">
            <button class="header-top__menu hamburger-menu" aria-label="Menü öffnen">
                {%- render 'icon', type: 'hamburger-menu' -%}
            </button>
            <div class="header-top__brand">
                <a href="{{ routes.root_url }}">
                    {%- if section.settings.logo != blank -%}
                        <img src="{{ section.settings.logo | img_url: 'master' }}" alt="{{ section.settings.logo | alt | default: shop.name | escape }}">
                    {%- endif -%}
                </a>
            </div>
            <nav class="header-navigation">
                <ul class="header-navigation-list">
                    {%- for link in main_menu.links -%}
                  		{%- if link.links == blank-%}
                        <li class="header-navigation-list__item" style="position:unset;">
                            <a href="{{ link.url }}">
                                <span>{{ link.title }}</span>
                            </a>
                        </li>
                  		{%- else -%}
                        <li class="header-navigation-list__item" style="position:unset;">
                            <a href="{{ link.url }}">
                                <span>{{ link.title }}</span>
                            </a>
                            {%- render 'mega-menu', link: link,blocks:section.blocks -%}
                        </li>
                  		{%- endif -%}
                    {%- endfor -%}
                </ul>
            </nav>
            <div class="header-top__icons">
                <ul style='align-items:center;'>
                    {%- comment -%}
                    <li class="header-icon search-icon" data-icon-type="Suchen">
                        <div class="header-icon__wrapper">
                            <a href="{{ routes.cart_url }}" aria-label="{{ shop.name }} durchsuchen">
                                {%- render 'icon', type: 'search' -%}
                            </a>
                        </div>
                    </li>
                    {%- endcomment -%}

                   
                    <li class="header-icon cart-icon" data-icon-type="{{ section.settings.searchtext }}">
                          <span class="header-icon__wrapper header-icon--js">
                              {%- render 'icon', type: 'search' -%}
                          </span>
                    </li>
                    <li class="header-icon cart-icon" data-icon-type="{{ section.settings.carttext }}">
                          <a 
                            class="header-icon__wrapper"
                            href="/cart"
                            data-item-count="{{ cart.item_count }}"
                            aria-label="{{ cart.item_count }} Artikel im Warenkorb"
                            >
                              {%- render 'icon', type: 'cart' -%}
                          </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
  <div class="site-width search-drawer">
    <div class="search-bar__interior">
		{%- render 'search-bar' -%}
    </div>
  </div>
</header>

<script>
  $('.header-icon--js').click(function(){
    console.log('clicked');
    $('.search-drawer').toggleClass('drawer-active');
  });
</script>

