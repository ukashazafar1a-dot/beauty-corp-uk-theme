<!-- Define progress-ring component -->
<script>
  class ProgressRing extends HTMLElement {
    constructor() {
      super();
      const stroke = this.getAttribute('stroke');
      const radius = this.getAttribute('radius');
      const normalizedRadius = radius - stroke * 2;
      this._circumference = normalizedRadius * 2 * Math.PI;

      this._root = this.attachShadow({mode: 'open'});
      this._root.innerHTML = `
        <svg
          height="${radius * 2}"
          width="${radius * 2}"
         >
           <circle
             stroke="#ffaa8f"
             stroke-dasharray="${this._circumference} ${this._circumference}"
             style="stroke-dashoffset:${this._circumference}"
             stroke-width="${stroke}"
             fill="transparent"
             r="${normalizedRadius}"
             cx="${radius}"
             cy="${radius}"
          />
        </svg>

        <style>
          circle {
            transition: stroke-dashoffset 0.35s;
            transform: rotate(-90deg);
            transform-origin: 50% 50%;
          }
        </style>
      `;
    }

    setProgress(percent) {
      const offset = this._circumference - (percent / 100 * this._circumference);
      const circle = this._root.querySelector('circle');
      circle.style.strokeDashoffset = offset; 
    }

    static get observedAttributes() {
      return ['progress'];
    }

    attributeChangedCallback(name, oldValue, newValue) {
      if (name === 'progress') {
        this.setProgress(newValue);
      }
    }
  }
  window.customElements.define('progress-ring', ProgressRing);  
</script>

<script>
  (function(){
    const url = "https://api.cloudinary.com/v1_1/getfabulous-karolina-bobb/image/upload";
    
    const submitBtn = $('button.job-submit');
    $('.job-form').find('.pdf-field').each((i,field)=>{
      $(field).on('change',function(){
      	console.log('Changed');
        console.log($(field).prop('files')[0]);
        if($(field).prop('files')[0]){
          var fileReader = new FileReader();
          fileReader.onload = function () {
            var data = fileReader.result;
            uploadFile(data,field);
          };
          fileReader.readAsDataURL($(field).prop('files')[0]);
        }
      });
    });

    function uploadFile(data,item){
      const formData = new FormData();
      formData.append("file", data);
      formData.append("upload_preset", "ehm1pk6f");
      // emulate progress attribute change
	  const progressRing = $(item).next();
      $(progressRing).attr('progress', 0);
      $.ajax({
        xhr: function() {
          var xhr = new window.XMLHttpRequest();
          xhr.upload.addEventListener("progress", function(evt) {
            if (evt.lengthComputable) {
              var percentComplete = evt.loaded / evt.total;
              percentComplete = parseInt(percentComplete * 100);
              $(progressRing).attr('progress', percentComplete);
              console.log(percentComplete);
              if (percentComplete === 100) {
                $(progressRing).attr('progress', 100);
                $(submitBtn).removeAttr('disabled');
              }else{
              	$(submitBtn).attr('disabled','disabled');
              }
            }
          }, false);
          return xhr;
        },
        url: url,
        type: "POST",
        data: formData,
        cache: false,
        contentType: false,
        processData: false,
        success: function(result) {
          let field = $(item).data('field');
		  $(`[name="${field}"]`).val(result.url);
        }
      });
    }
    function authenticate(form){
      let error = $(form).find('.job-form--errors');
      let name = $(form).find('[name="contact[name]"]');
      let email = $(form).find('[name="contact[email]"]');
      if($(name).val().trim() == ''){
      	$(error).html('Name is required');
        $(error).show();
        return true;
      }else if($(email).val().trim() == ''){
      	$(error).html('Email is required');
        $(error).show();
        return true;
      }else{
        $(error).hide();
      	return false;
      }
    }
    $(submitBtn).on('click',function(e){
      e.preventDefault();
      const form = $(this).closest('form');
      if(authenticate(form)) return;
      $(form).submit();
    });
  })();
  
