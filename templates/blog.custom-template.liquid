<!--main div-->
<div class="home blog  hfeed sidebar-right blog-classic vc_responsive">
<!--Top Menu -->
<div class="blog-header-menu">
	<div class="container">
		{% section 'blog-menus' %}		
	</div>
</div>
<!-- slick slider-->
{% if blog.handle == 'all' %}
  <div id="featured-content" class="featured-content posts-carousel">
      <div class="konte-container">
          {% section  'blog-feature-articles'%}
      </div>
  </div>
  {% else %}
  <div class="blog-header-main">
	<div class="konte-container">
		<div class="blog-header-title text-light">
			<h1 class="page-title">{{blog.title}}</h1>
        </div>
	</div>
  </div>
{%endif %}

  
<!--Main Content Area -->
  <div class="konte-container">
	<div id="primary" class="content-area">
		<main id="main" class="site-main">
          	{% if blog.handle == 'all' %}
          		{% assign all_blogs = "blog,news,handling-headband" | split:',' %}
                {% for blog in all_blogs %}
                    {% for articles in blogs[blog].articles %}
                        <article id="post-{{forloop.index}}" class="post-{{forloop.index}} post type-post status-publish format-standard has-post-thumbnail hentry category-fashion">
                            <a class="post-thumbnail" href="{{articles.url}}" aria-hidden="true"> <img width="500" height="750" src="{{articles.image.src | img_url:'500x'}}" class="attachment-post-thumbnail size-post-thumbnail wp-post-image" alt="image: {{articles.title}}"> </a>
                            <div class="entry">
                                <header class="entry-header">
                                    <div class="cat-links"> <a href="{{articles.blog.url}}" rel="category tag">{{article.blog.title}}</a> </div>
                                    <h2 class="entry-title"><a href="{{articles.url}}" rel="bookmark">{{articles.title}}</a></h2> </header>
                                <!-- .entry-header -->
                                <div class="entry-summary">
                                    <p>{{articles.excerpt}}&hellip;</p>
                                </div>
                                <!-- .entry-content -->
                                <footer class="entry-footer">
                                    <div class="entry-meta"> <span class="posted-on">
                                      <a href="{{articles.url}}" rel="bookmark">
                                        <time class="entry-date published updated" datetime="{{articles.published_at |date: '%d.%m.%Y'}}">{{articles.published_at | date: '%d.%m.%Y' }}
                                        </time>
                                      </a>
                                      </span><span class="total-shares " data-post_id="9832"><span class="svg-icon icon-share size-small "><svg role="img"> <use href="#share" xlink:href="#share"></use> </svg></span><span class="count">0 Share</span></span><span class="comments-link"><span class="svg-icon icon-comment size-small "><svg role="img"> <use href="#comment" xlink:href="#comment"></use> </svg></span><a href="https://carmushka.de/last-minute-weihnachtsgeschenke-von-amazon#respond">Keine Kommentare<span class="screen-reader-text"> zu Last-Minute-Weihnachtsgeschenke von Amazon</span></a></span>
                                    </div>
                                    <!-- .entry-meta -->
                                </footer>
                                <!-- .entry-footer -->
                            </div>
                        </article>
                    {% endfor %}
                {% endfor %}
          	{% else %}
          		{% for articles in blog.articles %}
                        <article id="post-{{forloop.index}}" class="post-{{forloop.index}} post type-post status-publish format-standard has-post-thumbnail hentry category-fashion">
                            <a class="post-thumbnail" href="{{articles.url}}" aria-hidden="true"> <img width="500" height="750" src="{{articles.image.src | img_url:'500x'}}" class="attachment-post-thumbnail size-post-thumbnail wp-post-image" alt="image: {{articles.title}}"> </a>
                            <div class="entry">
                                <header class="entry-header">
                                    <div class="cat-links"> <a href="{{articles.blog.url}}" rel="category tag">{{article.blog.title}}</a> </div>
                                    <h2 class="entry-title"><a href="{{articles.url}}" rel="bookmark">{{articles.title}}</a></h2> </header>
                                <!-- .entry-header -->
                                <div class="entry-summary">
                                    <p>{{articles.excerpt}}&hellip;</p>
                                </div>
                                <!-- .entry-content -->
                                <footer class="entry-footer">
                                    <div class="entry-meta"> <span class="posted-on"><a href="{{articles.url}}" rel="bookmark"><time class="entry-date published updated" datetime="{{articles.published_at |date: formate:'%d.%m.%Y'}}">{{articles.published_at | date: '%d.%m.%Y' }}</time></a></span><span class="total-shares " data-post_id="9832"><span class="svg-icon icon-share size-small "><svg role="img"> <use href="#share" xlink:href="#share"></use> </svg></span><span class="count">0 Share</span></span><span class="comments-link"><span class="svg-icon icon-comment size-small "><svg role="img"> <use href="#comment" xlink:href="#comment"></use> </svg></span><a href="https://carmushka.de/last-minute-weihnachtsgeschenke-von-amazon#respond">Keine Kommentare<span class="screen-reader-text"> zu Last-Minute-Weihnachtsgeschenke von Amazon</span></a></span>
                                    </div>
                                    <!-- .entry-meta -->
                                </footer>
                                <!-- .entry-footer -->
                            </div>
                        </article>
                    {% endfor %}
          		
          	{% endif %}
			<nav class="navigation next-posts-navigation">
				<h4 class="screen-reader-text">Next posts navigation</h4>
				<div class="nav-links"><a href="2.html">Load More</a></div>
			</nav>
		</main>
		<!-- #main -->
	</div>
	<!-- #primary -->
	<aside id="secondary" class="widget-area blog-sidebar sticky-sidebar">
	  {%- section 'blog-side-search' %}
      {% section "latest-articles" %}
      {% section "popular-articles" %}
	</aside>
	<!-- #secondary -->
</div>
<!-- .site-content-container -->


</div><!-- #content -->
