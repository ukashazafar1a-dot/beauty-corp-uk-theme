{% comment %}
{% paginate blog.articles by 5 %}

<h1>{{ blog.title }}</h1>
{% for article in blog.articles %}
  <div>
    <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
    {{ article.author }} @ {{ article.created_at }}
    <div>
      {% if article.excerpt.size > 0 %}
        {{ article.excerpt }}
      {% else %}
        <p>{{ article.content | strip_html | truncatewords: 100 }}</p>
      {% endif %}
    </div>
  </div>
{% endfor %}

{% if paginate.pages > 1 %}
  {{ paginate | default_pagination }}
{% endif %}

{% endpaginate %}
{% endcomment %}
<!--new template starts -->
<link rel="stylesheet" id="konte-css" href="{{'sf-new-style.css' | asset_url}}" type="text/css" media="all">
<link rel="stylesheet" href="https://pro.fontawesome.com/releases/v5.10.0/css/all.css" integrity="sha384-AYmEC3Yw5cVb3ZcuHtOA93w35dYTsvhLPVnYs9eStHfGJvOvKxVfELGroGkvsg+p" crossorigin="anonymous"/>
<link rel="stylesheet" id="font-awesome-css" href="https://carmushka.de/wp-content/plugins/js_composer/assets/lib/bower/font-awesome/css/font-awesome.min.css?ver=6.0.5" type="text/css" media="all">
<style id='konte-inline-css' type='text/css'>
		
	.topbar {
		height: 40px
	}
	
	.header-main,
	.header-v10 .site-branding {
		height: 120px;
	}
	
	.header-bottom {
		height: 90px;
	}
	
	.header-mobile {
		height: 60px
	}
	
	.featured-content-carousel,
	.featured-content-carousel .featured-item {
		height: 790px
	}
 
	
	@media screen and (max-width: 1440px) {
		.featured-content-carousel,
		.featured-content-carousel .featured-item {
			height: 592px
		}
	}
	
	@media screen and (max-width: 1280px) {
		.featured-content-carousel,
		.featured-content-carousel .featured-item {
